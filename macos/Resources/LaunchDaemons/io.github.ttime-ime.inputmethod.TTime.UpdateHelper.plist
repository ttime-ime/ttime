<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.ttime-ime.inputmethod.TTime.UpdateHelper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/TTimeUpdateHelper</string>
	<key>ProgramArguments</key>
	<array>
		<string>TTimeUpdateHelper</string>
	</array>
	<!-- Registered by the input method when background updates are on (the
	     default). Runs every 6 hours, and once when loaded in case the Mac was
	     asleep through a scheduled run. -->
	<key>StartInterval</key>
	<integer>21600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/var/log/TTimeUpdateHelper.log</string>
	<key>StandardOutPath</key>
	<string>/var/log/TTimeUpdateHelper.log</string>
</dict>
</plist>
